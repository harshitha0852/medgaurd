{
  "name": "MedicationLog",
  "type": "object",
  "properties": {
    "patient_email": {
      "type": "string"
    },
    "medication_id": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "reminder_sent",
        "video_submitted",
        "awaiting_review",
        "reviewed",
        "not_verified",
        "missed"
      ],
      "default": "scheduled"
    },
    "taken_at": {
      "type": "string"
    },
    "reported_reason": {
      "type": "string"
    },
    "video_uri": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "patient_email",
    "medication_name",
    "scheduled_date"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}