{
  "name": "VerificationVideo",
  "type": "object",
  "properties": {
    "patient_email": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "medication_id": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "log_id": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string"
    },
    "video_uri": {
      "type": "string"
    },
    "duration_sec": {
      "type": "number"
    },
    "submitted_at": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "flagged"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "reviewer_note": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "patient_email",
    "medication_name",
    "submitted_at"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}