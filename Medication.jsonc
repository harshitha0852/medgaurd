      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "generic_name": {
      "type": "string"
    },
    "dosage": {
      "type": "string"
    },
    "form": {
      "type": "string"
    },
    "frequency": {
      "type": "string"
    },
    "times": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "refill_date": {
      "type": "string"
    },
    "prescribed_by": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "source_record_id": {
      "type": "string"
    }
  },
  "required": [
