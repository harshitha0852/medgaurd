{
  "name": "CaregiverLink",
  "type": "object",
  "properties": {
    "patient_email": {
      "type": "string"
    },
    "caregiver_email": {
      "type": "string"
    },
    "caregiver_name": {
      "type": "string"
    },
    "relation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "revoked"
      ],
      "default": "pending"
    },
    "can_view_records": {
      "type": "boolean",
      "default": true
    },
    "can_view_videos": {
      "type": "boolean",
      "default": true
    },
    "can_manage_meds": {
      "type": "boolean",
      "default": false
    },
    "is_professional": {
      "type": "boolean",
      "default": false
    },
    "invited_at": {
      "type": "string"
    }
  },
  "required": [
    "patient_email",
    "caregiver_email"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}